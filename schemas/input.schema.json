{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/input.schema.json",
  "title": "TikTokStoryboardInput",
  "type": "object",
  "required": ["project", "script", "assets"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title", "aspectRatio", "style", "pace", "durationTarget"],
      "properties": {
        "title": {"type": "string"},
        "aspectRatio": {"type": "string", "enum": ["9:16"]},
        "style": {"type": "string"},
        "pace": {"type": "string", "enum": ["fast", "medium", "steady"]},
        "durationTarget": {"type": "number", "minimum": 3, "maximum": 120}
      }
    },
    "script": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "intent": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "path"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "path": {"type": "string"},
          "description": {"type": "string"},
          "width": {"type": "number"},
          "height": {"type": "number"},
          "focusRegions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "x", "y", "w", "h"],
              "properties": {
                "id": {"type": "string"},
                "label": {"type": "string"},
                "x": {"type": "number"},
                "y": {"type": "number"},
                "w": {"type": "number"},
                "h": {"type": "number"},
                "importance": {"type": "integer", "minimum": 1, "maximum": 5}
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "maxSceneCount": {"type": "integer", "minimum": 1, "maximum": 30},
        "maxCaptionCharsPerLine": {"type": "integer", "minimum": 6, "maximum": 20},
        "allowGlitch": {"type": "boolean"},
        "allowParallax": {"type": "boolean"},
        "needSubtitles": {"type": "boolean"}
      }
    }
  }
}
