{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/motion-plan.schema.json",
  "title": "MotionPlan",
  "description": "Deterministic render plan generated by compiling an AiMotionRequest. This plan is intended to be stable, reproducible, and renderable by the Remotion MotionPlan renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sourceRequestVersion",
    "image",
    "imageWidth",
    "imageHeight",
    "outputWidth",
    "outputHeight",
    "fps",
    "durationSeconds",
    "recipeId",
    "visualStructure",
    "camera",
    "overlays"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0",
      "description": "Schema version for MotionPlan output. Must be exactly '2.0'."
    },
    "sourceRequestVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the AiMotionRequest that was compiled to this plan."
    },
    "image": {
      "type": "string",
      "description": "Source image path carried through from the request. Render tooling may stage this asset into Remotion public/ before rendering."
    },
    "imageWidth": {
      "type": "integer",
      "minimum": 1,
      "description": "Source image width in pixels."
    },
    "imageHeight": {
      "type": "integer",
      "minimum": 1,
      "description": "Source image height in pixels."
    },
    "outputWidth": {
      "type": "integer",
      "minimum": 1,
      "description": "Output video width in pixels."
    },
    "outputHeight": {
      "type": "integer",
      "minimum": 1,
      "description": "Output video height in pixels."
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "description": "Target frame rate for rendering."
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "Total output duration in seconds."
    },
    "recipeId": {
      "type": "string",
      "enum": [
        "INFOGRAPHIC_OVERVIEW_TO_KEYPOINTS",
        "INFOGRAPHIC_STEP_SCAN",
        "STORYBOARD_PANEL_PUSH",
        "STORYBOARD_PANEL_HOP",
        "SCREENSHOT_TOP_TO_BOTTOM_SCAN",
        "COMPARISON_LEFT_RIGHT_REVEAL",
        "POSTER_HERO_DEPTH_PUSH",
        "COLLAGE_ASSEMBLE",
        "DOCUMENT_LINE_SPOTLIGHT",
        "PHOTO_KEN_BURNS"
      ],
      "description": "Recipe used to compile the camera path and overlays."
    },
    "visualStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "regions", "readingOrder"],
      "description": "Original structured visual understanding carried through from the request. Region coordinates remain source-image pixel coordinates.",
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "single-focus",
            "vertical-sections",
            "horizontal-sections",
            "grid",
            "comic-panels",
            "timeline",
            "comparison-split",
            "dense-document",
            "hero-title",
            "mixed"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "x", "y", "w", "h"],
            "properties": {
              "id": {"type": "string"},
              "role": {
                "type": "string",
                "enum": [
                  "title",
                  "subtitle",
                  "hero",
                  "number",
                  "chart",
                  "step",
                  "panel",
                  "comparison-left",
                  "comparison-right",
                  "quote",
                  "cta",
                  "detail",
                  "background"
                ]
              },
              "label": {"type": "string"},
              "x": {"type": "number", "minimum": 0},
              "y": {"type": "number", "minimum": 0},
              "w": {"type": "number", "exclusiveMinimum": 0},
              "h": {"type": "number", "exclusiveMinimum": 0},
              "importance": {"type": "number"},
              "order": {"type": "number"},
              "motionHint": {
                "type": "string",
                "enum": [
                  "hold",
                  "push-in",
                  "pull-out",
                  "pan-to",
                  "scan",
                  "hop",
                  "whip",
                  "reveal",
                  "compare"
                ]
              }
            }
          }
        },
        "readingOrder": {
          "type": "array",
          "items": {"type": "string"}
        },
        "primaryRegionId": {
          "type": "string"
        }
      }
    },
    "camera": {
      "type": "array",
      "minItems": 2,
      "description": "Ordered camera keyframes produced by the compiler.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "target", "scale"],
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0,
            "description": "Keyframe time in seconds."
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "full"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "regionId"],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "region"
                  },
                  "regionId": {
                    "type": "string",
                    "description": "Target region id from visualStructure.regions."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "cx", "cy"],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "point"
                  },
                  "cx": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "cy": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            ],
            "description": "Camera target. Region ids refer to pixel-coordinate regions in visualStructure."
          },
          "scale": {
            "type": "number",
            "minimum": 1,
            "description": "Zoom multiplier where 1 means full-image fit."
          },
          "easing": {
            "type": "string",
            "enum": ["linear", "easeInOut", "spring", "hold", "whip"],
            "description": "Optional easing used to approach this keyframe from the previous keyframe."
          },
          "label": {
            "type": "string",
            "description": "Optional debugging label."
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "description": "Timed overlay events rendered on top of the camera motion.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time", "duration", "type"],
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "focus-box",
              "spotlight",
              "caption",
              "number-pulse",
              "label",
              "wipe-line",
              "scan-line"
            ]
          },
          "regionId": {
            "type": "string",
            "description": "Optional region id for region-aware overlays."
          },
          "text": {
            "type": "string",
            "description": "Optional overlay text. Caption and label overlays should use this when text is needed."
          },
          "style": {
            "type": "object",
            "description": "Optional renderer-specific styling payload."
          }
        }
      }
    },
    "renderOptions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional renderer-facing controls carried from the original request constraints.",
      "properties": {
        "allowBlur": {
          "type": "boolean",
          "description": "When false, renderer-side motion blur should stay disabled."
        },
        "allowWhipPan": {
          "type": "boolean",
          "description": "When false, renderer-side whip-pan-specific effects should stay disabled."
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal compiler diagnostics.",
      "items": {
        "type": "string"
      }
    }
  }
}
